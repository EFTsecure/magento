<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="services-callpay-js" type="host">https://services.callpay.com</value>
                <value id="services-jquery" type="host">https://code.jquery.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="services-callpay" type="host">https://services.callpay.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <!-- Allow your domain -->
            <values>
                <value id="callpay-agent-local" type="host">https://agent.callpay.lh</value>
                <value id="callpay-agent" type="host">https://agent.callpay.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
