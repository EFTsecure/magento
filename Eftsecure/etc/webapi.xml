<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/eft/checkout/success" method="POST">
        <service class="Callpay\Eftsecure\Api\SuccessApiInterface" method="execute"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/eft/secure" method="POST">
        <service class="Callpay\Eftsecure\Api\EftSecureInterface" method="eftSecure"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/orders/quote/:quoteId" method="GET">
        <service class="Callpay\Eftsecure\Api\OrderManagementInterface" method="getOrderByQuoteId"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
