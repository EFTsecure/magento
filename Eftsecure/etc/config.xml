<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <eftpay>
                <active>1</active>
                <title>Eftsecure</title>
                <order_status>pending_payment</order_status>
                <instructions>Pay via instant eft</instructions>
                <model>Callpay\Eftsecure\Model\Eftpay</model>
                <allowspecific>0</allowspecific>
                <group>offline</group>
            </eftpay>
        </payment>
        <callpay>
            <general>
                <callpay_base_url>https://agent.callpay.com</callpay_base_url>
            </general>
        </callpay>
    </default>
</config>
